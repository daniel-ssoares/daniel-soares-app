---
// Projetos pessoais ($ ls ~/github/): cards com imagens, destaques, link ao vivo e link do repositório.
// Lista em src/config.ts → site.projects. Cada card ocupa a largura toda: imagens de um lado, texto do outro.
// Imagens (componente <Image> do Astro: otimiza, carrega sob demanda e reserva o espaço com width/height):
// - verticais (prints de celular): molduras de celular lado a lado, com rolagem horizontal se não couberem;
// - horizontais: moldura de navegador com a capa e, se houver, miniaturas da galeria embaixo.
import { Image } from 'astro:assets';
import { site, type Lang, type Project } from '../config';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = site.projects;
const host = (url: string | null, fallback: string) => (url ? new URL(url).host : fallback);
const isPortrait = (p: Project) => p.images.length > 0 && p.images[0].src.height > p.images[0].src.width;
---

<div class="projects">
  <p class="cmd">{t('projects.cmd')}</p>

  <div class="list">
    {
      projects.map((p) => {
        const [cover, ...gallery] = p.images;
        const label = p.title?.[lang] ?? p.name;
        return (
          <article class:list={['project', { 'no-media': !cover }]}>
            {cover &&
              (isPortrait(p) ? (
                <ul class="phones" tabindex="0" aria-label={`${t('projects.screens')}: ${label}`}>
                  {p.images.map((img) => (
                    <li class="phone">
                      <Image src={img.src} alt={img.alt[lang]} widths={[240, 480]} sizes="(max-width: 900px) 45vw, 220px" />
                    </li>
                  ))}
                </ul>
              ) : (
                <div class="media">
                  <figure class="window">
                    <div class="titlebar" aria-hidden="true">
                      <span class="dots">
                        <i />
                        <i />
                        <i />
                      </span>
                      <span class="mono url">{host(p.live, `${p.name}.local`)}</span>
                    </div>
                    <Image src={cover.src} alt={cover.alt[lang]} widths={[640, 960, 1440]} sizes="(max-width: 900px) 100vw, 620px" />
                  </figure>
                  {gallery.length > 0 && (
                    <ul class="thumbs">
                      {gallery.map((img) => (
                        <li>
                          <Image src={img.src} alt={img.alt[lang]} widths={[320, 640]} sizes="(max-width: 900px) 33vw, 200px" />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}

            <div class="body">
              <p class="mono head">
                <span class="name">{p.name}/</span>
                <span class={`status ${p.status}`}>[{t(p.status === 'live' ? 'projects.published' : 'projects.building')}]</span>
              </p>
              {p.title && <h3>{p.title[lang]}</h3>}
              <p class="description">{p.description[lang]}</p>
              {p.highlights && (
                <ul class="highlights" aria-label={t('projects.highlights')}>
                  {p.highlights[lang].map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              <ul class="tags" aria-label={t('work.tags')}>
                {p.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              <div class="actions">
                {p.live ? (
                  <a class="btn btn-primary" href={p.live} target="_blank" rel="noopener noreferrer">
                    <Icon name="external" size={15} />
                    {t('projects.live')}
                  </a>
                ) : (
                  <span class="btn" aria-disabled="true">
                    {t('projects.liveSoon')}
                  </span>
                )}
                {p.repo && (
                  <a class="btn" href={p.repo} target="_blank" rel="noopener noreferrer">
                    <Icon name="github" size={15} />
                    {t('projects.repo')}
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <p class="more mono">
    <a href={site.contact.github} target="_blank" rel="noopener noreferrer">
      <Icon name="github" size={14} />
      {t('projects.profile')}
    </a>
  </p>
</div>

<style>
  .projects {
    margin-top: 40px;
  }

  .list {
    display: grid;
    gap: 16px;
  }

  /* Card: imagens à esquerda, texto à direita */
  .project {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 48px);
    padding: clamp(16px, 2.5vw, 28px);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s;
  }

  .project:hover {
    border-color: var(--border-strong);
  }

  .no-media {
    grid-template-columns: 1fr;
  }

  /* Prints verticais: molduras de celular lado a lado */
  .phones {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 1fr);
    gap: 12px;
    margin: 0;
    padding: 4px 4px 12px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--border-strong) transparent;
  }

  .phones:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .phone {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 18px;
    background: var(--bg);
    box-shadow: 0 20px 40px -24px rgb(0 0 0 / 0.8);
    scroll-snap-align: start;
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Imagens horizontais: moldura de navegador */
  .media {
    display: grid;
    gap: 10px;
  }

  .window {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
    background: var(--bg);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 30px;
    padding-inline: 12px;
    border-bottom: 1px solid var(--border);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .url {
    font-size: 0.6875rem;
    color: var(--subtle);
  }

  .window :global(img),
  .thumbs :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .thumbs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thumbs li {
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
  }

  .name {
    font-size: 1.0625rem;
    font-weight: 500;
    color: #7dd3fc;
  }

  .status {
    font-size: 0.75rem;
    color: #fbbf24;
  }

  .status.live {
    color: var(--accent);
  }

  h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.15;
  }

  .description {
    color: var(--muted);
  }

  .highlights {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }

  .highlights li {
    position: relative;
    padding-left: 1.5em;
    color: var(--text);
  }

  .highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 4px;
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: 16px;
    font-size: 0.8125rem;
  }

  .more a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    text-decoration: none;
  }

  .more a:hover {
    color: var(--heading);
  }

  @media (max-width: 900px) {
    .project {
      grid-template-columns: 1fr;
    }
  }
</style>
