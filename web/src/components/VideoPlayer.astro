---
// Player do vídeo de apresentação, estilizado como uma janela.
//
// Comportamento:
// - autoplay só funciona MUDO nos navegadores: autoplay + muted + loop + playsinline
// - botões "ativar som" (em destaque) e "pausar" (acessibilidade)
// - legendas ligadas por padrão, já que o vídeo começa sem som
// - prefers-reduced-motion: sem autoplay
// Só é usado quando site.video.mp4 existe; antes disso o hero mostra HeroTerminal.astro.
import { site, type Lang } from '../config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { mp4, webm, poster, captions } = site.video;
---

<figure class="window" aria-label={t('video.label')}>
  <div class="titlebar" aria-hidden="true">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="mono filename">apresentacao.mp4</span>
  </div>

  {
    mp4 && (
      <div class="player" data-video-player>
        <video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster ?? undefined}
          aria-label={t('video.label')}
        >
          {webm && <source src={webm} type="video/webm" />}
          <source src={mp4} type="video/mp4" />
          <track kind="captions" src={captions.pt} srclang="pt" label="Português" default={lang === 'pt'} />
          <track kind="captions" src={captions.en} srclang="en" label="English" default={lang === 'en'} />
        </video>

        {/* Roda antes do vídeo começar: quem pediu menos movimento não recebe autoplay */}
        <script is:inline>
          (function () {
            var v = document.currentScript.previousElementSibling;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              v.removeAttribute('autoplay');
              v.autoplay = false;
              v.pause();
            }
          })();
        </script>

        <div class="controls">
          <button
            type="button"
            class="btn btn-primary"
            data-action="sound"
            data-label-on={t('video.unmute')}
            data-label-off={t('video.mute')}
          >
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 5 6 9H2v6h4l5 4V5z" />
              <path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" />
            </svg>
            <span>{t('video.unmute')}</span>
          </button>

          <button
            type="button"
            class="btn icon"
            data-action="play"
            data-label-pause={t('video.pause')}
            data-label-play={t('video.play')}
            aria-label={t('video.pause')}
          >
            <svg class="i-pause" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
            <svg class="i-play" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z" /></svg>
          </button>

          <button
            type="button"
            class="btn icon mono cc"
            data-action="captions"
            data-label-on={t('video.captionsOn')}
            data-label-off={t('video.captionsOff')}
            aria-label={t('video.captionsOn')}
            aria-pressed="true"
          >
            CC
          </button>
        </div>
      </div>
    )
  }
</figure>

<script>
  import { setupVideoPlayer } from '../scripts/video-player';

  document.querySelectorAll<HTMLElement>('[data-video-player]').forEach(setupVideoPlayer);
</script>

<style>
  .window {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.7);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 38px;
    padding-inline: 14px;
    border-bottom: 1px solid var(--border);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .filename {
    font-size: 0.75rem;
    color: var(--subtle);
  }

  .player {
    position: relative;
  }

  video {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #0a0b0e;
  }

  video {
    object-fit: cover;
  }

  /* Legendas com fonte do site e fundo discreto */
  video::cue {
    font-family: var(--font-sans);
    font-size: 0.95em;
    background: rgb(0 0 0 / 0.72);
  }

  .controls {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .controls .btn {
    min-height: 40px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .controls .icon {
    justify-content: center;
    width: 40px;
    padding: 0;
    background: rgb(14 15 19 / 0.6);
    border-color: rgb(255 255 255 / 0.18);
  }

  .controls .cc {
    margin-left: auto;
    font-size: 0.75rem;
  }

  .cc[aria-pressed='false'] {
    color: var(--subtle);
    text-decoration: line-through;
  }

  .i-play,
  [data-paused='true'] .i-pause {
    display: none;
  }

  [data-paused='true'] .i-play {
    display: block;
  }
</style>
