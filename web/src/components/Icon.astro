---
// Ícones em SVG embutido (sem biblioteca externa). Herdam a cor do texto (currentColor).
// Uso: <Icon name="github" /> ou <Icon name="external" size={14} />
// Marcas (github, linkedin): desenhos oficiais simplificados, de Simple Icons (CC0).
// Demais: traço no estilo Lucide (ISC).

export type IconName = 'github' | 'linkedin' | 'mail' | 'external' | 'download' | 'arrow-right';

interface Props {
  name: IconName;
  size?: number;
  label?: string; // texto para leitores de tela; sem ele o ícone é decorativo
}

const { name, size = 16, label } = Astro.props;

// Ícones de marca são preenchidos; os demais são de traço
const filled: Record<string, string> = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z',
};

const stroked: Record<string, string[]> = {
  mail: ['M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z', 'm3 7 9 6 9-6'],
  external: ['M14 4h6v6', 'M10 14 20 4', 'M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5'],
  download: ['M12 4v12', 'm7 11 5 5 5-5', 'M5 20h14'],
  'arrow-right': ['M5 12h14', 'm13 6 6 6-6 6'],
};
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  fill={filled[name] ? 'currentColor' : 'none'}
  stroke={filled[name] ? undefined : 'currentColor'}
  stroke-width={filled[name] ? undefined : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {filled[name] ? <path d={filled[name]} /> : stroked[name]?.map((d) => <path d={d} />)}
</svg>

<style>
  .icon {
    flex-shrink: 0;
    vertical-align: middle;
  }
</style>
