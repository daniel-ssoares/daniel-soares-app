---
// Seção "Trabalhos selecionados" ($ ls trabalhos/).
// - Primeiro os projetos pessoais ($ ls ~/github/, componente Projects.astro).
// - Depois os cases de clientes ($ ls clientes/): o primeiro (menor `order`) em destaque,
//   com problema → solução → resultado e o número grande; os demais em duas colunas.
//
// Os cases vêm da Content Collection (estáticos, sempre disponíveis). Depois que a página abre,
// um script tenta buscar /api/cases; se a API responder, troca pelos dados do banco usando os <template> abaixo.
import { getCollection } from 'astro:content';
import type { Lang } from '../config';
import { useTranslations } from '../i18n/ui';
import Projects from './Projects.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const [featured, ...others] = (await getCollection('cases', (c) => c.data.lang === lang))
  .map((c) => c.data)
  .sort((a, b) => a.order - b.order);

const meta = (c: { client: string; context?: string }) => [c.client, c.context].filter(Boolean).join(' · ');
---

<section id="trabalhos" class="container section" aria-labelledby="work-title">
  <span class="cmd">{t('work.cmd')}</span>
  <h2 id="work-title" class="section-title">
    {t('work.title')} <em>{t('work.titleItalic')}</em>
  </h2>

  <Projects lang={lang} />

  <p class="cmd clients">{t('work.clients')}</p>
  <div class="cases" data-cases data-lang={lang}>
    {
      featured && (
        <article class="featured">
          <div class="featured-head">
            <p class="mono"><span class="badge">{t('work.featured')}</span></p>
            <p class="meta mono">{meta(featured)}</p>
            <h3>{featured.title}</h3>
            {featured.metric && (
              <p class="metric">
                <span class="metric-value">{featured.metric.value}</span>
                <span class="metric-label mono">{featured.metric.label}</span>
              </p>
            )}
          </div>

          <div class="featured-body">
            <dl class="steps">
              {featured.problem && (
                <div>
                  <dt class="mono">{t('work.problem')}</dt>
                  <dd>{featured.problem}</dd>
                </div>
              )}
              <div>
                <dt class="mono">{t('work.solution')}</dt>
                <dd>{featured.summary}</dd>
              </div>
              {featured.result && (
                <div>
                  <dt class="mono">{t('work.result')}</dt>
                  <dd>{featured.result}</dd>
                </div>
              )}
            </dl>
            <ul class="tags" aria-label={t('work.tags')}>
              {featured.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </div>
        </article>
      )
    }

    <div class="grid">
      {
        others.map((c) => (
          <article class="case">
            <p class="meta mono">{meta(c)}</p>
            <h3>{c.title}</h3>
            <p class="summary">{c.summary}</p>
            <ul class="tags" aria-label={t('work.tags')}>
              {c.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Moldes usados pelo script (src/scripts/cases-api.ts) para montar os cases vindos da API -->
  <template data-template="featured">
    <article class="featured">
      <div class="featured-head">
        <p class="mono"><span class="badge">{t('work.featured')}</span></p>
        <p class="meta mono"></p>
        <h3></h3>
        <p class="metric"><span class="metric-value"></span><span class="metric-label mono"></span></p>
      </div>
      <div class="featured-body">
        <dl class="steps">
          <div data-step="problem"><dt class="mono">{t('work.problem')}</dt><dd></dd></div>
          <div data-step="solution"><dt class="mono">{t('work.solution')}</dt><dd></dd></div>
          <div data-step="result"><dt class="mono">{t('work.result')}</dt><dd></dd></div>
        </dl>
        <ul class="tags" aria-label={t('work.tags')}></ul>
      </div>
    </article>
  </template>
  <template data-template="case">
    <article class="case">
      <p class="meta mono"></p>
      <h3></h3>
      <p class="summary"></p>
      <ul class="tags" aria-label={t('work.tags')}></ul>
    </article>
  </template>
  <template data-template="grid"><div class="grid"></div></template>
</section>

<script>
  import { loadCasesFromApi } from '../scripts/cases-api';

  const container = document.querySelector<HTMLElement>('[data-cases]');
  if (container) void loadCasesFromApi(container);
</script>

<style>
  .clients {
    display: block;
    margin: 56px 0 20px;
  }

  .cases {
    display: grid;
    gap: 16px;
  }

  article {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s;
  }

  article:hover {
    border-color: var(--border-strong);
  }

  .badge {
    display: inline-block;
    padding: 2px 10px;
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    border-radius: 999px;
    font-size: 0.6875rem;
  }

  .meta {
    font-size: 0.75rem;
    color: var(--subtle);
  }

  /* Case em destaque */
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 64px);
    padding: clamp(24px, 4vw, 44px);
  }

  .featured-head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .featured h3 {
    font-size: clamp(1.9rem, 3.2vw, 2.5rem);
    line-height: 1.1;
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
    padding-top: 24px;
  }

  .metric-value {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 9vw, 6.5rem);
    line-height: 0.9;
    color: var(--accent);
  }

  .metric-label {
    font-size: 0.8125rem;
    color: var(--subtle);
  }

  .featured-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .steps {
    display: grid;
    gap: 20px;
    margin: 0;
  }

  .steps > div {
    display: grid;
    gap: 4px;
    padding-left: 16px;
    border-left: 1px solid var(--border-strong);
  }

  .steps dt {
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: lowercase;
  }

  .steps dt::before {
    content: '→ ';
  }

  .steps dd {
    margin: 0;
    color: var(--text);
  }

  .featured-body .tags {
    margin-top: auto;
  }

  /* Demais cases em duas colunas */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .case {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
  }

  .case h3 {
    font-size: 1.6rem;
    line-height: 1.15;
  }

  .summary {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .case .tags {
    margin-top: auto;
    padding-top: 8px;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .case {
      padding: 24px;
    }
  }

  @media (max-width: 800px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }
</style>
