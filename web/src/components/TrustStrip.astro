---
// Faixa de confiança logo abaixo do hero (só texto).
import type { Lang } from '../config';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const clients = [t('trust.1'), t('trust.2'), t('trust.3')];
---

<section class="container" aria-label={t('trust.aria')}>
  <div class="strip">
    <p class="lead mono">{t('trust.lead')} <span class="arrow" aria-hidden="true">→</span></p>
    <ul class="clients">
      {clients.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px 32px;
    margin-top: clamp(48px, 6vw, 72px);
    padding-block: 26px;
    border-block: 1px solid var(--border);
  }

  .lead {
    font-size: 0.8125rem;
    color: var(--subtle);
    white-space: nowrap;
  }

  .arrow {
    color: var(--accent);
  }

  .clients {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    color: var(--heading);
  }

  .clients li + li::before {
    content: '/';
    margin-inline: 14px;
    color: var(--border-strong);
  }

  @media (max-width: 720px) {
    .clients {
      flex-direction: column;
    }

    .clients li + li::before {
      content: none;
    }
  }
</style>
