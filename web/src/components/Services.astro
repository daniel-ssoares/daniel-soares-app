---
// Seção de serviços ($ ls servicos/), voltada a quem procura alguém para construir um projeto.
// Textos em src/i18n/ui.ts (chaves services.N.title / services.N.text).
import type { Lang } from '../config';
import { useTranslations, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [1, 2, 3, 4].map((n) => ({
  index: String(n).padStart(2, '0'),
  title: t(`services.${n}.title` as UiKey),
  text: t(`services.${n}.text` as UiKey),
}));
---

<section id="servicos" class="container section" aria-labelledby="services-title">
  <span class="cmd">{t('services.cmd')}</span>
  <h2 id="services-title" class="section-title">
    {t('services.title')} <em>{t('services.titleItalic')}</em>
  </h2>

  <ul class="services">
    {
      services.map((s) => (
        <li>
          <span class="index mono">{s.index}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  li {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-content: start;
    gap: 8px 16px;
    padding: 32px 32px 32px 0;
    border-bottom: 1px solid var(--border);
  }

  li:nth-child(even) {
    padding-left: 32px;
    padding-right: 0;
    border-left: 1px solid var(--border);
  }

  .index {
    grid-row: span 2;
    padding-top: 8px;
    font-size: 0.75rem;
    color: var(--accent);
  }

  h3 {
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.15;
  }

  p {
    max-width: 44ch;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 800px) {
    .services {
      grid-template-columns: 1fr;
    }

    li,
    li:nth-child(even) {
      padding: 26px 0;
      border-left: 0;
    }
  }
</style>
