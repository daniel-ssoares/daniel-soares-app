---
// Layout base: <html>, <head> (SEO, fontes, idiomas alternativos) e <body>.
// Todas as páginas usam este layout.
import '../styles/global.css';
import type { Lang } from '../config';
import { routes, useTranslations, type Page } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: Page;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

const title = page === 'contact' ? t('meta.contactTitle') : t('meta.title');
const description = page === 'contact' ? t('meta.contactDescription') : t('meta.description');

const canonical = new URL(routes[page][lang], Astro.site);
const altPt = new URL(routes[page].pt, Astro.site);
const altEn = new URL(routes[page].en, Astro.site);
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E0F13" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={altPt} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altPt} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />

    <!-- Fontes: Instrument Serif (títulos), Inter (texto), JetBrains Mono (detalhes de terminal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t('nav.skip')}</a>
    <slot />

    <script>
      import { trackVisit } from '../scripts/visits';

      trackVisit();
    </script>
  </body>
</html>
