---
// Layout base: <html>, <head> (SEO, fontes, idiomas alternativos) e <body>.
// Todas as páginas usam este layout.
import '../styles/global.css';
import type { Lang } from '../config';
import { routes, useTranslations, type Page } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Sem page (ex.: 404): sem canonical/hreflang e fora dos buscadores */
  page?: Page;
}

const { lang, page } = Astro.props;
const t = useTranslations(lang);

const title = page === 'contact' ? t('meta.contactTitle') : page ? t('meta.title') : t('notFound.metaTitle');
const description = page === 'contact' ? t('meta.contactDescription') : t('meta.description');

const canonical = page && new URL(routes[page][lang], Astro.site);
const altPt = page && new URL(routes[page].pt, Astro.site);
const altEn = page && new URL(routes[page].en, Astro.site);
// Imagem de prévia ao compartilhar o link (1200×630, em public/og/)
const ogImage = new URL(`/og/og-${lang}.png`, Astro.site);
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E0F13" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      page ? (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="pt-BR" href={altPt} />
          <link rel="alternate" hreflang="en" href={altEn} />
          <link rel="alternate" hreflang="x-default" href={altPt} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daniel Soares" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('meta.ogImageAlt')} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fontes: Instrument Serif (títulos), Inter (texto), JetBrains Mono (detalhes de terminal) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{t('nav.skip')}</a>
    <slot />

    <script>
      import { trackVisit } from '../scripts/visits';

      trackVisit();
    </script>
  </body>
</html>
