---
// Página 404. A Vercel serve uma só para o site inteiro, então ela mostra os dois idiomas:
// português primeiro e inglês logo abaixo, cada um com o link para o seu início.
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../config';
import { routes, useTranslations } from '../i18n/ui';

const langs: Lang[] = ['pt', 'en'];
---

<BaseLayout lang="pt">
  <header class="container top">
    <a class="logo mono" href={routes.home.pt}>~/daniel-soares</a>
  </header>

  <main id="conteudo" class="container main">
    <p class="mono shell">
      <span class="prompt">$</span> cd <span data-path>/</span>
    </p>

    {
      langs.map((lang) => {
        const t = useTranslations(lang);
        return (
          <section class="block" lang={lang === 'pt' ? 'pt-BR' : 'en'}>
            <p class="mono error">{t('notFound.error')}</p>
            {lang === 'pt' ? (
              <h1>
                {t('notFound.title')} <em>{t('notFound.titleItalic')}</em>
              </h1>
            ) : (
              <h2>
                {t('notFound.title')} <em>{t('notFound.titleItalic')}</em>
              </h2>
            )}
            <p class="text">{t('notFound.text')}</p>
            <a class:list={['btn', { 'btn-primary': lang === 'pt' }]} href={routes.home[lang]}>
              {t('notFound.home')}
            </a>
          </section>
        );
      })
    }
  </main>

  <Footer lang="pt" />
</BaseLayout>

<script>
  // Mostra no "cd" o endereço que a pessoa tentou abrir (como texto, nunca como HTML)
  const path = document.querySelector('[data-path]');
  if (path) {
    try {
      path.textContent = decodeURI(location.pathname);
    } catch {
      path.textContent = location.pathname;
    }
  }
</script>

<style>
  .top {
    padding-block: 24px;
  }

  .logo {
    color: var(--heading);
    text-decoration: none;
  }

  .main {
    display: grid;
    gap: 40px;
    padding-block: clamp(40px, 8vw, 96px);
  }

  .shell {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .prompt {
    color: var(--accent);
  }

  .block {
    display: grid;
    justify-items: start;
    gap: 16px;
  }

  .block + .block {
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .error {
    font-size: 0.875rem;
    color: #f87171;
  }

  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  .text {
    max-width: 52ch;
    color: var(--muted);
  }
</style>
